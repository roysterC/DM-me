# DM-me server settings. setup.sh copies this to /etc/dm-me/dm-me.env (readable by root only).
# One KEY=value per line, no quotes needed. Run `sudo systemctl restart dm-me` after editing.

# The domain that points at this server. Caddy gets the HTTPS certificate for it.
# No domain? Use dm-me- plus the server's IP address with dashes plus .nip.io, e.g.
# dm-me-203-0-113-10.nip.io (setup.sh prints yours if this is left as is). Every site on the
# server needs its own name, so don't reuse one another site already uses.
DOMAIN=chat.example.com

# Required for Alisa to reply. https://platform.claude.com/
ANTHROPIC_API_KEY=

# Unlocks https://<DOMAIN>/admin to manage Alisa's camera roll and stories.
ADMIN_PASSWORD=

# Cloudflare R2 (or any S3-compatible bucket). Holds the photos AND the database backups.
# Without it, photos stay on this server's disk and there are no backups.
S3_BUCKET=
S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Signs cookies and photo links. Generated by setup.sh; keep it the same across reinstalls.
SECRET=

# Optional
# CADDY=off                    # you run the web server yourself: setup won't install or change Caddy
# PORT=3000                    # local port for the app; if 3000 is taken, setup picks a free one and saves it here
# DAILY_REPLY_LIMIT=200
# AUTO_STORIES=off
# SAMPLE_PHOTOS=off
# PHOTO_SECONDS=5
