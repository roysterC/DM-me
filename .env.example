# Required for Nova to reply. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# PORT=3000
# DATA_DIR=data                 # SQLite database and uploaded photos
# ADMIN_USERNAMES=yourname      # comma-separated; these accounts can manage Nova's stories at /admin
# AUTO_STORIES=off              # stop re-posting Nova's sample stories when none are live
# PHOTO_SECONDS=5               # how long a view-once photo stays on screen
# DM_ME_FAKE_AI=1               # canned replies for local testing, no API calls
