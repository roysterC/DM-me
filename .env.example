# Required for Nova to reply. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Unlocks /admin, where you manage Nova's camera roll and stories.
ADMIN_PASSWORD=

# Photo storage in an S3-compatible bucket (recommended on a small VPS).
# Cloudflare R2 example: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto.
# Leave S3_BUCKET empty to keep photos on this server's disk instead.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE=false          # only if your provider needs bucket.endpoint style URLs

# Optional
# ANTHROPIC_MODEL=claude-haiku-5-5
# PORT=3000
# DATA_DIR=data                 # SQLite database (small: chat text and photo descriptions)
# DAILY_REPLY_LIMIT=200         # Nova replies per visitor per day
# AUTO_STORIES=off              # stop re-posting the sample stories when none are live
# SAMPLE_PHOTOS=off             # don't add the four sample photos to Nova's camera roll
# PHOTO_SECONDS=5               # how long a view-once photo stays on screen
# SECRET=                       # signs cookies and photo links; generated into DATA_DIR if unset
# DM_ME_FAKE_AI=1               # canned replies for local testing, no API calls
